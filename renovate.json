{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "enabled": true,
  "semanticCommits": true,
  "semanticCommitScope": "deps",
  "semanticCommitType": "chore",
  "schedule": [
    "before 3am every day"
  ],
  "rangeStrategy": "auto",
  "ignoreDeps": [],
  "packageRules": [
    {
      "description": "Group npm devDependencies updates",
      "groupName": "npm devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchManagers": ["npm"],
      "schedule": ["before 3am every day"]
    },
    {
      "description": "Group npm dependencies updates",
      "groupName": "npm dependencies",
      "matchDepTypes": ["dependencies"],
      "matchManagers": ["npm"],
      "schedule": ["before 3am every day"]
    },
    {
      "description": "Group Python dependencies updates",
      "groupName": "Python dependencies",
      "matchManagers": ["pip"],
      "schedule": ["before 3am every day"]
    },
    {
      "description": "Minor and patch updates for Next.js ecosystem",
      "groupName": "Next.js ecosystem",
      "matchPackagePatterns": ["^next", "^@next", "^react", "^react-dom"],
      "schedule": ["before 3am every day"]
    },
    {
      "description": "Minor and patch updates for MUI",
      "groupName": "Material-UI updates",
      "matchPackagePatterns": ["^@mui"],
      "schedule": ["before 3am every day"]
    },
    {
      "description": "Auto-merge patch and minor updates for low-risk packages",
      "groupName": "Low-risk auto-merge",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackagePatterns": [
        "^date-fns",
        "^prettier",
        "^@types/",
        "^typescript"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "assignees": [],
    "reviewers": []
  },
  "postUpdateOptions": [
    "npmDedupe"
  ]
}
