# Google AdSense クライアント ID
# AdSense アカウント取得後、以下の形式で ID を設定してください
# 例：NEXT_PUBLIC_ADSENSE_ID=ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_ID=

# 広告ユニット ID（任意）
# AdSense ダッシュボードで広告ユニットを作成し、それぞれの ID を設定
# 未設定の場合は広告プレースホルダーが表示されます

# サイドバー広告（デスクトップ用）
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=

# モバイル広告（モバイル用）
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=
